+// Strange Journey draws its interface with flat (orthographic) polygons. In widescreen:
+// - the status bar's corner blocks, the moon phase on the left and SEARCH/ANALYZE on the right, move
+//   out to the edges of the wider picture; the middle of the bar stays put;
+// - the battle command menu (COMMANDS header, command rows and the submenu beside them) moves to the
+//   left edge and down, clear of the moon block. It is recognised by its header and by row-sized polygons, which
+//   keeps enemy sprites (also flat, but taller) and other screens' windows in place.
+// Bounds are in 4:3 DS pixels, found by logging the polygons of dungeon and battle frames.
+void GPU3D::PegWideScreenHud(int nverts) noexcept
+{
+    constexpr float barTopMaxY = 4.f, barBottomMaxY = 26.f;
+    constexpr float leftBlockMaxX = 75.f, rightBlockMinX = 181.f;
+    constexpr float menuTopY = 15.f, menuBottomY = 101.f, menuRowMaxHeight = 16.f, menuMaxX0 = 194.f;
+    // 12 rows down puts the COMMANDS header under the moon block and keeps the last row above the
+    // description box at row 115
+    constexpr s32 menuDropRows = 12;
+
+    s32 w = TempVertexBuffer[0].Position[3];
+    if (w <= 0)
+        return;
+    for (int i = 1; i < nverts; i++)
+        if (TempVertexBuffer[i].Position[3] != w)
+            return;
+
+    float x0 = 1e9f, x1 = -1e9f, y0 = 1e9f, y1 = -1e9f;
+    for (int i = 0; i < nverts; i++)
+    {
+        // undo the 3/4 squeeze to get back to 4:3 screen pixels
+        float x = ((float)TempVertexBuffer[i].Position[0] / w * 4.f / 3.f + 1.f) * 128.f;
+        float y = (1.f - (float)TempVertexBuffer[i].Position[1] / w) * 96.f;
+        x0 = std::min(x0, x); x1 = std::max(x1, x);
+        y0 = std::min(y0, y); y1 = std::max(y1, y);
+    }
+    // a quarter of w in squeezed clip space is exactly the widescreen side margin
+    s32 shift = 0, drop = 0;
+    if (y0 <= barTopMaxY && y1 <= barBottomMaxY)
+    {
+        if (x1 <= leftBlockMaxX)
+            shift = -w / 4;
+        else if (x0 >= rightBlockMinX)
+            shift = w / 4;
+    }
+    else
+    {
+        bool menuHeader = x0 <= 1.f && std::abs(y0 - 16.f) <= 1.f && std::abs(y1 - 24.f) <= 1.f;
+        if (menuHeader)
+            MenuSeenThisFrame = true;
+        bool menuVisible = MenuSeenThisFrame || MenuSeenLastFrame;
+        // battle sprites are flat too, but sit behind the camera plane (z > 0) while the interface
+        // is drawn in front of it
+        bool inFront = TempVertexBuffer[0].Position[2] < 0;
+        bool menuRow = inFront && y0 >= menuTopY && y1 <= menuBottomY
+            && (y1 - y0) <= menuRowMaxHeight && x0 < menuMaxX0;
+        if (menuVisible && menuRow)
+        {
+            shift = -w / 4;
+            // clip-space y runs up from -w to w over 192 rows
+            drop = -(w * menuDropRows) / 96;
+        }
+    }
+    if (shift == 0)
+        return;
+    for (int i = 0; i < nverts; i++)
+    {
+        TempVertexBuffer[i].Position[0] += shift;
+        TempVertexBuffer[i].Position[1] += drop;
+    }
+}
